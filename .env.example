# ============================================================
# JupyterHub EKS 배포 환경 설정
# cp .env.example .env 후 값을 채워서 사용하세요
# ============================================================

# AWS 설정
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=148142828185

# EKS 클러스터
EKS_CLUSTER_NAME=test-jupyterhub-cluster

# Kubernetes 네임스페이스 / Helm 릴리스명
NAMESPACE=jupyterhub
HELM_RELEASE=jupyterhub

# JupyterHub 관리자 계정
JUPYTERHUB_ADMIN=admin

# Proxy 인증 토큰 — 비워두면 deploy.sh가 openssl rand -hex 32 로 자동 생성
# 재배포 간 세션 유지가 필요하면 고정값으로 설정
CONFIGPROXY_AUTH_TOKEN=

# JupyterHub 공개 URL — 비워두면 deploy.sh가 NLB 주소에서 자동 감지
# 커스텀 도메인을 사용하는 경우 여기에 설정 (예: https://jupyterhub.example.com)
JUPYTERHUB_PUBLIC_URL=

# code-server 버전
CODE_VERSION=4.95.3

# ============================================================
# Cognito OIDC — 셋 다 비워두면 NativeAuthenticator(username/password)로 폴백
# ============================================================
# Cognito 도메인. 형식: https://<prefix>.auth.<region>.amazoncognito.com
COGNITO_DOMAIN=
# Cognito App Client ID / Secret
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# ============================================================
# LiteLLM 마스터 키 — 비워두면 deploy.sh가 sk-<random>으로 자동 생성하고
# 이 파일에 다시 써넣음 (재배포 간 같은 키 유지)
# ============================================================
LITELLM_MASTER_KEY=

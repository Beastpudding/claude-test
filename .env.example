# ============================================================
# JupyterHub 환경 설정
# 이 파일을 .env로 복사하여 사용하세요: cp .env.example .env
# ============================================================

# JupyterHub 관리자 계정
JUPYTERHUB_ADMIN=admin

# 외부에서 접근할 포트
JUPYTERHUB_PORT=8000

# 사용자 노트북 Docker 이미지 (로컬 빌드 시)
DOCKER_NOTEBOOK_IMAGE=codeserver-kbdev:local

# ============================================================
# 폐쇄망 설정 (필요시 주석 해제)
# ============================================================
# PIP_INDEX_URL=http://192.168.176.138:8787/api/repo/pypi
# PIP_TRUSTED_HOST=192.168.176.138

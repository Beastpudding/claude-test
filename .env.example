# ============================================================
# JupyterHub EKS 배포 환경 설정
# cp .env.example .env 후 값을 채워서 사용하세요
# ============================================================

# AWS 설정
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=148142828185

# EKS 클러스터
EKS_CLUSTER_NAME=test-jupyterhub-cluster

# Kubernetes 네임스페이스 / Helm 릴리스명
NAMESPACE=jupyterhub
HELM_RELEASE=jupyterhub

# JupyterHub 관리자 계정
JUPYTERHUB_ADMIN=admin

# Proxy 인증 토큰 — 비워두면 deploy.sh가 openssl rand -hex 32 로 자동 생성
# 재배포 간 세션 유지가 필요하면 고정값으로 설정
CONFIGPROXY_AUTH_TOKEN=

# JupyterHub 공개 URL — 비워두면 deploy.sh가 NLB 주소에서 자동 감지
# 커스텀 도메인을 사용하는 경우 여기에 설정 (예: https://jupyterhub.example.com)
JUPYTERHUB_PUBLIC_URL=

# code-server 버전
CODE_VERSION=4.95.3

# ============================================================
# AWS IAM Identity Center (SSO) — JupyterHub OIDC 로그인
# IAM Identity Center 콘솔에서 OAuth2 애플리케이션을 생성하고
# 아래 값을 입력하세요. 비워두면 NativeAuthenticator를 사용합니다.
# ============================================================

# IAM Identity Center 포털 시작 URL
# 예: https://d-1234567890.awsapps.com/start
SSO_START_URL=

# 애플리케이션 OIDC 클라이언트 ID / 시크릿
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# ============================================================
# LiteLLM — Claude Code → Bedrock 프록시
# 비워두면 deploy.sh가 자동 생성합니다.
# ============================================================
LITELLM_MASTER_KEY=sk-bd794bde5630b54b762672035639cb047c442e353de9f601

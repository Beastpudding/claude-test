FROM quay.io/jupyter/base-notebook:latest

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ============================================================
# Build Arguments - 폐쇄망 환경에서 오버라이드 가능
# ============================================================
ARG CODE_VERSION=4.95.3
ARG TARGETARCH

# ============================================================
# root로 전환하여 시스템 패키지 설치
# ============================================================
USER root

# jovyan 사용자에 sudo 권한 부여 및 비밀번호 설정
RUN echo "jovyan:jovyan" | chpasswd && \
    echo "jovyan ALL=(ALL:ALL) NOPASSWD:ALL" >> /etc/sudoers

# Copy Code Server Settings (있는 경우에만)
COPY ./code-server/ /home/jovyan/code-server/
RUN chmod -R 755 /home/jovyan/code-server && \
    chown -R jovyan:users /home/jovyan/code-server

# ============================================================
# System packages 설치 (폐쇄망: deadsnakes PPA 제거)
# ============================================================
RUN apt-get clean && \
    apt-get update --yes && \
    apt-get install --yes --quiet --no-install-recommends \
    curl \
    openssh-client \
    git \
    vim \
    gnupg \
    pandoc \
    unzip \
    iptables \
    supervisor \
    && \
    apt-get --quiet clean && rm -rf /var/lib/apt/lists/*

# ============================================================
# OpenCode CLI 설치
# ============================================================
RUN curl -fsSL https://opencode.ai/install | bash && \
    if [ -f /root/.opencode/bin/opencode ]; then \
        cp /root/.opencode/bin/opencode /usr/local/bin/opencode; \
    fi && \
    chmod +x /usr/local/bin/opencode 2>/dev/null || true

# ============================================================
# Docker-in-Docker (DinD) 설치
# 각 사용자 컨테이너에서 독립된 Docker daemon 실행
# ============================================================
RUN curl -fsSL https://get.docker.com | sh && \
    usermod -aG docker jovyan

# Docker Compose 설치
RUN curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" \
    -o /usr/local/bin/docker-compose && \
    chmod +x /usr/local/bin/docker-compose

# DinD entrypoint 스크립트: supervisord로 dockerd를 백그라운드 실행
COPY dind-supervisor.conf /etc/supervisor/conf.d/dockerd.conf

# ============================================================
# Code Server 설치
# 폐쇄망: .deb 파일을 미리 다운로드하여 COPY로 대체 가능
# ============================================================
# 폐쇄망: .deb 파일을 미리 준비하여 COPY (deploy.sh가 자동 다운로드 처리)
COPY code-server_${CODE_VERSION}_${TARGETARCH}.deb /tmp/
RUN dpkg -i /tmp/code-server_${CODE_VERSION}_${TARGETARCH}.deb && \
    rm -f /tmp/code-server_${CODE_VERSION}_${TARGETARCH}.deb

# ============================================================
# VS Code Extensions 사전 설치 (폐쇄망용 vsix)
# - OpenCode: sst-dev.opencode
# - Live Preview: ms-vscode.live-server
# code-server --install-extension을 사용하여 extensions.json 매니페스트 자동 생성
# ============================================================
COPY vsix_extensions/*.vsix /tmp/vsix/
RUN mkdir -p /opt/code-server-extensions && \
    for vsix in /tmp/vsix/*.vsix; do \
        echo "Installing extension: $(basename $vsix)" && \
        code-server --extensions-dir /opt/code-server-extensions \
            --install-extension "$vsix" ; \
    done && \
    rm -rf /tmp/vsix && \
    chmod -R 755 /opt/code-server-extensions

# code-server가 사전설치된 extensions 디렉토리를 사용하도록 설정
RUN mkdir -p /home/jovyan/.local/share/code-server/User && \
    echo '{"extensions.autoCheckUpdates":false,"extensions.autoUpdate":false}' \
    > /home/jovyan/.local/share/code-server/User/settings.json

# ============================================================
# Jupyter Proxy Extensions (code-server 연동)
# ============================================================
RUN /opt/conda/bin/conda install -y -c conda-forge \
    jupyter-server-proxy jupyter-vscode-proxy || \
    pip install jupyter-server-proxy jupyter-vscode-proxy

# ============================================================
# Custom Launcher Extension (Jupyter/VSCode/Terminal 런처 페이지)
# ============================================================
COPY launcher_ext/launcher_ext.py /opt/jupyter-custom-launcher/launcher_ext.py
COPY launcher_ext.json /etc/jupyter/jupyter_server_config.d/launcher_ext.json
ENV PYTHONPATH="/opt/jupyter-custom-launcher:${PYTHONPATH}"

# ============================================================
# Python 3.7 / 3.8 / 3.9 설치 (conda 환경 + Jupyter 커널 등록)
# 기본 Python은 3.9로 설정
# ============================================================
RUN conda create -y -n py37 python=3.7 ipykernel && \
    conda create -y -n py38 python=3.8 ipykernel && \
    conda create -y -n py39 python=3.9 ipykernel && \
    /opt/conda/envs/py37/bin/python -m ipykernel install --name py37 --display-name "Python 3.7" && \
    /opt/conda/envs/py38/bin/python -m ipykernel install --name py38 --display-name "Python 3.8" && \
    /opt/conda/envs/py39/bin/python -m ipykernel install --name py39 --display-name "Python 3.9" && \
    conda clean -afy

# Python 3.9를 시스템 기본 python으로 설정
# 1) before-notebook.d/20-activate-py39.sh → Jupyter 서버가 py39로 실행됨
# 2) .bashrc → 사용자 터미널에서도 python3=3.9
RUN printf '#!/bin/bash\nconda activate py39\n' > /usr/local/bin/before-notebook.d/20-activate-py39.sh && \
    chmod +x /usr/local/bin/before-notebook.d/20-activate-py39.sh && \
    echo 'conda activate py39 2>/dev/null' >> /home/jovyan/.bashrc

# ============================================================
# pip 설정
# 빌드 시: 외부 PyPI(기본)에서 라이브러리 다운로드
# 런타임 시: entrypoint(dind.sh)에서 환경변수 기반으로 pip.conf 동적 생성
# ============================================================
RUN pip install virtualenv

# ============================================================
# code-server 설정 이동 (start.sh 이전에 처리)
# ============================================================
RUN mkdir -p /home/jovyan/.local/share && \
    if [ -d /home/jovyan/code-server ]; then \
        cp -r /home/jovyan/code-server /home/jovyan/.local/share/code-server; \
    fi && \
    chown -R jovyan:users /home/jovyan/.local

# ============================================================
# DinD entrypoint: start-notebook.d 훅으로 자동 실행
# ============================================================
COPY entrypoint-dind.sh /usr/local/bin/start-notebook.d/dind.sh
RUN chmod +x /usr/local/bin/start-notebook.d/dind.sh

# ============================================================
# 작업 디렉토리 설정
# ============================================================
RUN mkdir -p /home/jovyan/work && \
    chown -R jovyan:users /home/jovyan

USER ${NB_UID}
WORKDIR /home/jovyan/work

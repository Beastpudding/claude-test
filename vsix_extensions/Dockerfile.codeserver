FROM quay.io/jupyter/base-notebook:python-3.12

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG CODE_VERSION=4.95.3
ARG TARGETARCH

USER root

RUN echo "jovyan:jovyan" | chpasswd && \
    echo "jovyan ALL=(ALL:ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN apt-get clean && \
    apt-get update --yes && \
    apt-get install --yes --quiet --no-install-recommends \
    curl \
    openssh-client \
    git \
    vim \
    gnupg \
    pandoc \
    unzip \
    iptables \
    supervisor \
    && \
    apt-get --quiet clean && rm -rf /var/lib/apt/lists/*

# ============================================================
# OpenCode CLI
# ============================================================
RUN curl -fsSL https://opencode.ai/install | bash && \
    if [ -f /root/.opencode/bin/opencode ]; then \
        cp /root/.opencode/bin/opencode /usr/local/bin/opencode; \
    fi && \
    chmod +x /usr/local/bin/opencode 2>/dev/null || true

# ============================================================
# Docker-in-Docker (DinD)
# ============================================================
RUN curl -fsSL https://get.docker.com | sh && \
    usermod -aG docker jovyan

RUN curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" \
    -o /usr/local/bin/docker-compose && \
    chmod +x /usr/local/bin/docker-compose

COPY dind-supervisor.conf /etc/supervisor/conf.d/dockerd.conf

# ============================================================
# Code Server
# ============================================================
COPY code-server_${CODE_VERSION}_${TARGETARCH}.deb /tmp/
RUN dpkg -i /tmp/code-server_${CODE_VERSION}_${TARGETARCH}.deb && \
    rm -f /tmp/code-server_${CODE_VERSION}_${TARGETARCH}.deb

# ============================================================
# VS Code Extensions (pre-installed VSIX)
# ============================================================
COPY vsix_extensions/*.vsix /tmp/vsix/
RUN mkdir -p /opt/code-server-extensions && \
    for vsix in /tmp/vsix/*.vsix; do \
        echo "Installing extension: $(basename $vsix)" && \
        code-server --extensions-dir /opt/code-server-extensions \
            --install-extension "$vsix" ; \
    done && \
    rm -rf /tmp/vsix && \
    chmod -R 755 /opt/code-server-extensions

# ============================================================
# Claude Code OAuth callback patch:
# Replaces redirect_uri=http://localhost:{port}/callback with
# MANUAL_REDIRECT_URL so claude.ai accepts the redirect.
# After approval, claudeOAuthWaitForCompletion() polls Anthropic
# to complete login automatically — no copy-paste needed.
# ============================================================
RUN python3 - <<'PYEOF'
import glob, sys, re

files = glob.glob('/opt/code-server-extensions/anthropic.claude-code-*/extension.js')
if not files:
    print("WARNING: Claude Code extension.js not found, skipping OAuth patch")
    sys.exit(0)

f = files[0]
with open(f, 'r', errors='replace') as fp:
    content = fp.read()

m = re.search(r'MANUAL_REDIRECT_URL:"([^"]+)"', content)
if not m:
    print("WARNING: MANUAL_REDIRECT_URL not found in extension.js - patch skipped")
    sys.exit(0)
MANUAL_REDIRECT_URL = m.group(1)
print("Found MANUAL_REDIRECT_URL:", MANUAL_REDIRECT_URL)

OLD = 'async openURL(V){if(x4.env.remoteName){'

INJECT = (
    'try{'
    'if(V&&typeof V==="string"&&V.includes("redirect_uri=")){'
    'var _dV=decodeURIComponent(V);'
    r'if(_dV.match(/redirect_uri=http:\/\/localhost:\d+\/callback/)){'
    'V=V.replace('
    r'/redirect_uri=http%3A%2F%2Flocalhost%3A\d+%2Fcallback/,'
    '"redirect_uri=" + encodeURIComponent("' + MANUAL_REDIRECT_URL + '")'
    ');'
    '}'
    '}'
    '}catch(_e){}'
)
NEW = 'async openURL(V){' + INJECT + 'if(x4.env.remoteName){'

print("Brace balance:", INJECT.count('{') - INJECT.count('}'), "(should be 0)")

if OLD in content:
    content = content.replace(OLD, NEW, 1)
    with open(f, 'w') as fp:
        fp.write(content)
    print("OAuth callback patch applied to:", f)
    print("redirect_uri will be rewritten to:", MANUAL_REDIRECT_URL)
else:
    print("WARNING: openURL pattern not found in", f, "- patch skipped (extension may have updated)")
PYEOF

# ============================================================
# Claude Code native binary (linux-arm64 / linux-x64)
# VSIX from marketplace contains macOS binary; fetch linux one from npm.
# ============================================================
RUN CLAUDE_EXT=$(ls -d /opt/code-server-extensions/anthropic.claude-code-*/resources 2>/dev/null | head -1) && \
    if [ -n "$CLAUDE_EXT" ]; then \
        ARCH=$(uname -m) && \
        case "$ARCH" in \
            aarch64) PLAT="linux-arm64" ;; \
            x86_64)  PLAT="linux-x64"   ;; \
            *) echo "Unsupported arch: $ARCH" && exit 0 ;; \
        esac && \
        echo "Fetching claude binary for ${PLAT}..." && \
        PKG_URL=$(curl -sf "https://registry.npmjs.org/@anthropic-ai/claude-code-${PLAT}/latest" \
            | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['dist']['tarball'])") && \
        mkdir -p "${CLAUDE_EXT}/native-binaries/${PLAT}" && \
        curl -sL "${PKG_URL}" | tar -xzOf - package/claude \
            > "${CLAUDE_EXT}/native-binaries/${PLAT}/claude" && \
        chmod 755 "${CLAUDE_EXT}/native-binaries/${PLAT}/claude" && \
        echo "Claude binary installed: $(${CLAUDE_EXT}/native-binaries/${PLAT}/claude --version 2>&1)"; \
    fi

RUN mkdir -p /home/jovyan/.local/share/code-server/User && \
    echo '{"extensions.autoCheckUpdates":false,"extensions.autoUpdate":false}' \
    > /home/jovyan/.local/share/code-server/User/settings.json

# ============================================================
# Jupyter Proxy Extensions (code-server integration)
# ============================================================
RUN /opt/conda/bin/conda install -y -c conda-forge \
    jupyter-server-proxy jupyter-vscode-proxy || \
    pip install jupyter-server-proxy jupyter-vscode-proxy

# ============================================================
# Custom Launcher Extension
# ============================================================
COPY launcher_ext/launcher_ext.py /opt/jupyter-custom-launcher/launcher_ext.py
COPY launcher_ext.json /etc/jupyter/jupyter_server_config.d/launcher_ext.json
ENV PYTHONPATH="/opt/jupyter-custom-launcher:${PYTHONPATH}"

# ============================================================
# pip tools
# ============================================================
RUN pip install virtualenv

RUN mkdir -p /home/jovyan/.local/share && \
    chown -R jovyan:users /home/jovyan/.local

# ============================================================
# DinD entrypoint via start-notebook.d hook
# ============================================================
COPY entrypoint-dind.sh /usr/local/bin/start-notebook.d/dind.sh
RUN chmod +x /usr/local/bin/start-notebook.d/dind.sh

RUN mkdir -p /home/jovyan/work && \
    chown -R jovyan:users /home/jovyan

# Patch code-server to pass "use-host-proxy": true to the VS Code server initializer.
# This makes the extension host start with --useHostProxy=true, which enables
# the service worker's processLocalhostRequest to resolve vscode-resource:// URLs
# through VSCODE_PROXY_URI (the JupyterHub absolute proxy) instead of localhost.
RUN sed -i \
    's/"without-connection-token": true }))/"without-connection-token": true, "use-host-proxy": true }))/' \
    /usr/lib/code-server/out/node/routes/vscode.js

# code-server wrapper: sets VSCODE_PROXY_URI so the extension host enables
# host-proxy mode and webview resources route through the JupyterHub proxy.
# JUPYTERHUB_PUBLIC_URL is injected by deploy.sh via singleuser.extraEnv
# (e.g. http://elb-host). JUPYTERHUB_SERVICE_PREFIX (e.g. /user/admin/)
# is set by KubeSpawner at runtime.
RUN cat > /usr/local/bin/code-server <<'WRAPPER_EOF'
#!/bin/bash
if [ -n "${JUPYTERHUB_PUBLIC_URL}" ] && [ -n "${JUPYTERHUB_SERVICE_PREFIX}" ]; then
    export VSCODE_PROXY_URI="${JUPYTERHUB_PUBLIC_URL%/}${JUPYTERHUB_SERVICE_PREFIX}proxy/{{port}}/"
fi
exec /usr/bin/code-server "$@"
WRAPPER_EOF
RUN chmod +x /usr/local/bin/code-server

USER ${NB_UID}
WORKDIR /home/jovyan/work
